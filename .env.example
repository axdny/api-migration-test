# Copy to `.env` to override the defaults. `.env` is git-ignored.
#
# By default the suite starts the bundled mock APIs, so none of this is required.

# Base URLs of the two APIs under test
API_CORE_URL=http://localhost:4010
API_LEGACY_URL=http://localhost:4011

# Set to "true" to skip the bundled mock and test real/remote APIs instead
USE_EXTERNAL_API=false

# Credentials used by the token scenarios (demo values for the mock only)
TEST_USER=qa.user@example.com
TEST_PASSWORD=Demo#Pass123

# Number of iterations for performance comparison scenarios (0 = use the number in the feature)
COMPARISON_ITERATIONS=0
